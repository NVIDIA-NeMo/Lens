# Copy to .env and fill in real values. .env is gitignored.
#
# Used by docker-compose.otel.yml, docker-compose.honeycomb.yml, and
# docker-compose.weave.yml. Only the vars for the collector mode / backend
# you're running need to be filled in; the rest can be left as-is.

# ── W&B Weave mode (collector-weave.yaml) ─────────────────────────────
# API key from https://wandb.ai/authorize
WANDB_API_KEY=<paste-your-wandb-api-key-here>

# Entity (team or username slug) and project. Used as resource attributes
# on every span so Weave routes traces to the correct project.
WANDB_ENTITY=<your-wandb-entity>
WANDB_PROJECT=lens-test

# ── Honeycomb mode (collector-honeycomb.yaml) ─────────────────────────
# Ingest API key from Honeycomb UI → Environment settings → API Keys
HONEYCOMB_API_KEY=<paste-your-honeycomb-ingest-key-here>

# Dataset name. Required for metrics; recommended for traces and logs.
# Pick anything meaningful; Honeycomb creates it on first write.
HONEYCOMB_DATASET=nemo-lens

# Optional: override for EU instance.
# HONEYCOMB_ENDPOINT=https://api.eu1.honeycomb.io:443
