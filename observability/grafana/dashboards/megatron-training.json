{
  "title": "Megatron-LM Training",
  "uid": "megatron-training",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["megatron", "training", "llm"],
  "description": "Training metrics emitted via OpenTelemetry from Megatron-LM.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(megatron_training_loss, service_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Current Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Loss",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 4,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "megatron_training_loss{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Throughput",
      "type": "stat",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "green", "value": 1000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "megatron_training_throughput_tflops{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}} TFLOP/s/GPU",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Grad Norm",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "expr": "megatron_training_grad_norm{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Steps Completed",
      "type": "stat",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "expr": "megatron_training_step_duration_ms_milliseconds_count{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Training Curves",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Training Loss",
      "description": "Training loss over time (gauge).",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 3,
            "showPoints": "auto"
          },
          "unit": "none"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "megatron_training_loss{service_name=~\"$service\"}",
          "legendFormat": "loss {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Gradient Norm",
      "description": "Global gradient norm (gauge). Spikes may indicate training instability.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 3,
            "showPoints": "auto"
          },
          "unit": "none"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "megatron_training_grad_norm{service_name=~\"$service\"}",
          "legendFormat": "grad_norm {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Performance",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Throughput (TFLOP/s/GPU)",
      "description": "Training throughput (gauge).",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "pointSize": 3,
            "showPoints": "auto"
          },
          "unit": "none",
          "displayName": "TFLOP/s/GPU"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "megatron_training_throughput_tflops{service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Step Duration (ms)",
      "description": "Per-step wall-clock time (histogram p50/p95/p99).",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "ms"
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(megatron_training_step_duration_ms_milliseconds_bucket{service_name=~\"$service\"}[2m])))",
          "legendFormat": "p50 {{service_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(megatron_training_step_duration_ms_milliseconds_bucket{service_name=~\"$service\"}[2m])))",
          "legendFormat": "p95 {{service_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(megatron_training_step_duration_ms_milliseconds_bucket{service_name=~\"$service\"}[2m])))",
          "legendFormat": "p99 {{service_name}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 23,
      "title": "Step Duration Heatmap",
      "description": "Distribution of step durations over time.",
      "type": "heatmap",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "color": { "scheme": "Oranges", "mode": "scheme" },
        "yAxis": { "unit": "ms" },
        "cellGap": 1,
        "tooltip": { "show": true }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(megatron_training_step_duration_ms_milliseconds_bucket{service_name=~\"$service\"}[1m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "id": 24,
      "title": "Avg Step Duration (ms)",
      "description": "Mean step duration computed from histogram sum/count.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "ms"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(megatron_training_step_duration_ms_milliseconds_sum{service_name=~\"$service\"}[2m]) / rate(megatron_training_step_duration_ms_milliseconds_count{service_name=~\"$service\"}[2m])",
          "legendFormat": "avg {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "title": "Skipped Iterations",
      "description": "Rate of optimizer steps skipped due to inf/nan gradients. High rates indicate instability.",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 23, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "bars"
          },
          "unit": "short",
          "noValue": "0"
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(megatron_training_skipped_iters_total{service_name=~\"$service\"}[2m])",
          "legendFormat": "skipped/s {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Inference (GenAI Semconv)",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": true,
      "panels": [
        {
          "id": 31,
          "title": "Inference Request Duration (s)",
          "description": "End-to-end inference request latency (gen_ai.server.request.duration).",
          "type": "timeseries",
          "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
          },
          "targets": [
            {
              "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(gen_ai_server_request_duration_seconds_bucket{service_name=~\"$service\"}[2m])))",
              "legendFormat": "p50 {{service_name}}",
              "refId": "A"
            },
            {
              "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(gen_ai_server_request_duration_seconds_bucket{service_name=~\"$service\"}[2m])))",
              "legendFormat": "p99 {{service_name}}",
              "refId": "B"
            }
          ]
        },
        {
          "id": 32,
          "title": "Token Usage (TFLOP/s/GPU)",
          "description": "Input and output token throughput (gen_ai.client.token.usage).",
          "type": "timeseries",
          "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
          },
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "expr": "sum by (gen_ai_token_type, service_name) (rate(gen_ai_client_token_usage_sum{service_name=~\"$service\"}[2m]))",
              "legendFormat": "{{gen_ai_token_type}} {{service_name}}",
              "refId": "A"
            }
          ]
        }
      ]
    }
  ]
}
