{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "nemo_lens",
      "password": "example",
      "tags": [
        "administrator"
      ]
    }
  ],
  "permissions": [
    {
      "user": "nemo_lens",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "nemo_lens.otel.raw",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "nemo_lens-processing",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "nemo_lens-poison",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "nemo_lens.otel.raw",
      "vhost": "/",
      "destination": "nemo_lens-processing",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
  ]
}
